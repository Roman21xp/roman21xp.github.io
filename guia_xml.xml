<!-- ════════════════════════════════════════════════════════
    REGLAS — DOCUMENTO BIEN FORMADO
    (lo que comprueba el profesor al corregir)
    ════════════════════════════════════════════════════════

CORRECTO                      MAL — ERROR

<nombre>Jeff</nombre>           <nombre>Jeff          ← tag no cerrado
<item id="1">                   <item id=1>           ← atributo sin comillas
<a><b></b></a>                  <a><b></a></b>        ← tags solapados
<?xml ... ?> al principio       <?xml ... ?> en medio ← declaración mal puesta
Un solo elemento raíz           Dos elementos raíz    ← XML inválido
precio &lt; 100                 precio < 100          ← carácter sin escapar

-->


<!-- ════════════════════════════════════════════════════════
    CARACTERES ESPECIALES — HAY QUE ESCAPARLOS
    ════════════════════════════════════════════════════════ -->

<?xml version="1.0" encoding="UTF-8"?>
<ejemplos>

    <!-- Usando escapes: -->
    <comparacion>El precio es &lt; 100 &amp; &gt; 10</comparacion>
    <!-- Se verá como: El precio es < 100 & > 10 -->

    <enlace url="https://ejemplo.com?a=1&amp;b=2">Click aquí</enlace>

    <!-- CDATA: cuando hay mucho texto con caracteres especiales -->
    <!-- Dentro de CDATA NO hace falta escapar nada -->
    <codigo>
        <![CDATA[
            if (precio < 100 && stock > 0) {
                alert("En stock");
            }
        ]]>
    </codigo>

</ejemplos>

<!--
TABLA DE ESCAPES:
┌─────────────┬────────────┬─────────────────────────┐
│  Símbolo    │  Escape    │  Nombre                 │
├─────────────┼────────────┼─────────────────────────┤
│  <          │  &lt;      │  less than              │
│  >          │  &gt;      │  greater than           │
│  &          │  &amp;     │  ampersand              │
│  "          │  &quot;    │  comilla doble          │
│  '          │  &apos;    │  comilla simple         │
└─────────────┴────────────┴─────────────────────────┘
-->


<!-- ════════════════════════════════════════════════════════
    ATRIBUTOS vs ELEMENTOS HIJO — CUÁNDO USAR CADA UNO
    ════════════════════════════════════════════════════════ -->

<?xml version="1.0" encoding="UTF-8"?>
<productos>

    <!--
      USA ATRIBUTO cuando es:
        - un identificador (id, código)
        - un estado/flag (true/false, activo/inactivo)
        - un metadato corto (tipo, categoría)
    -->
    <producto id="P001" activo="true" categoria="electronica">

    <!--
      USA ELEMENTO HIJO cuando es:
        - el dato principal
        - texto largo
        - algo que puede tener sub-datos
    -->
        <nombre>Portátil Lenovo</nombre>
        <descripcion>Procesador Intel i7, 16GB RAM, SSD 512GB</descripcion>
        <precio moneda="EUR">899.00</precio>

    </producto>

</productos>


