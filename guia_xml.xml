<!-- ============================================================
    GUÍA XML — EXAMEN LENGUAJES DE MARCAS
    Lo que entra: crear o arreglar un fichero XML
    Lo que NO entra: DTD, XPATH, XSLT
    ============================================================ -->


<!-- ════════════════════════════════════════════════════════
    ESTRUCTURA MÍNIMA OBLIGATORIA
    ════════════════════════════════════════════════════════

Todo XML válido necesita:
    1. Declaración en la primera línea (la de arriba ↑)
    2. UN SOLO elemento raíz que envuelve todo lo demás
    3. Todos los tags cerrados
    4. Atributos siempre entre comillas
-->

<raiz>
    <elemento>Contenido de texto</elemento>
    <otro atributo="valor">Más texto</otro>
</raiz>


