<!-- ════════════════════════════════════════════════════════
     EJERCICIO TÍPICO: ARREGLA ESTE XML (con errores)
     ════════════════════════════════════════════════════════

  El profesor puede darte un XML roto y pedirte que lo corrijas.
  Busca siempre:
    1. ¿Falta cerrar algún tag?
    2. ¿Algún atributo sin comillas?
    3. ¿Hay más de un elemento raíz?
    4. ¿Hay < > & sin escapar dentro del contenido?
    5. ¿La declaración está en la primera línea?

  EJEMPLO CON ERRORES:
    <libros>
        <libro id=1>                       ← atributo sin comillas
            <titulo>Cien años de soledad   ← tag no cerrado
            <autor>García Márquez</autor>
        </libro>
        <libro id="2">
            <titulo>1984</titulo>
            <precio>precio < 10€</precio>  ← < sin escapar
        </libro>
    </libros>
    <extras></extras>                      ← segundo elemento raíz

  CORREGIDO:
-->
<?xml version="1.0" encoding="UTF-8"?>
<libros>
    <libro id="1">
        <titulo>Cien años de soledad</titulo>
        <autor>García Márquez</autor>
    </libro>
    <libro id="2">
        <titulo>1984</titulo>
        <precio>precio &lt; 10€</precio>
    </libro>
</libros>
